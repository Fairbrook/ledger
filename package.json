{
  "name": "ledger",
  "version": "0.1.0",
  "description": "Desktop experiment log: plan experiments as ordered runs, record what was tested, and keep qualitative and quantitative results together.",
  "main": "out/main/index.js",
  "desktopName": "ledger.desktop",
  "author": "fairbrook",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "api": "node --disable-warning=ExperimentalWarning --import tsx src/cli/api.ts",
    "mcp": "node --disable-warning=ExperimentalWarning --import tsx src/cli/mcp.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "install:linux": "sh scripts/install-appimage.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
